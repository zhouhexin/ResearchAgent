.DS_Store

# Local configuration and secrets.
.env
.env.*
!.env.example

# Python artifacts.
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and package metadata.
.venv/
venv/
env/
*.egg-info/

# Frontend dependencies and build output.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# IDE/editor state.
.idea/
.vscode/

# Runtime logs and generated experiment details.
logs/
experiments/runs/
experiments/web_runs/
experiments/web_feedback.jsonl
experiments/web_paper_index.json

# DenseX/generated retrieval artifacts. Keep the main FAISS index in storage/
# because it lets a fresh clone run the existing baseline immediately.
experiments/densex_corpus/
storage/densex/

# Large model checkpoints should be downloaded from their source instead of
# committed to the repository.
*.safetensors
*.ckpt
*.pt
*.pth
